# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# DSH 运行 pnpm 时会在项目根建本地 store（机器用，不提交）
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

.reasonix/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log

# env files
.env
.env*.local

# agent traces (黑匣子轨迹，不提交)
.traces/

# agent sessions (会话记忆 JSONL，不提交)
.sessions/

# repo updater baselines (C15 仓库更新基线，机器用，不提交)
.repo-updates/

# workspace 学习笔记（用户决策：全部不进 git）
/workspace/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地冒烟测试日志（E2 步骤3 起 dev server 时产生）
dev-server.log
