# 教学模式：设为 true 使用 MockModel（不需要 API Key，可离线学习）
# 设为 false 则使用真实 DeepSeek API
MOCK_MODE=true

# 仅在 MOCK_MODE=false 时需要
DEEPSEEK_API_KEY=sk-your-key-here

# ── 主对话（OpenAI 兼容，走 ${baseUrl}/chat/completions）──────────────
# 可选：覆盖默认值（默认 https://api.deepseek.com / deepseek-v4-flash）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash   # 或 deepseek-v4-pro，以官方文档为准

# ── 联网搜索（Anthropic 兼容，走 ${baseUrl}/messages）────────────────
# ⚠️ 和上面**不是一条路**，所以是独立变量。空了会退回官方端点。
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash

# ── 联网工具的行为旋钮（不随 provider 变）────────────────────────────
# 想知道搜索插件给了几条结果，或想快速试出抓取的截断行为，改这里。
# WEB_SEARCH_MAX_TOKENS=4096
# WEB_SEARCH_MAX_USES=5
# WEB_SEARCH_MAX_RESULTS=8
# WEB_SEARCH_MAX_QUERIES=4
# WEB_FETCH_TIMEOUT_MS=15000
# WEB_FETCH_MAX_BYTES=1048576
# WEB_FETCH_MAX_REDIRECTS=3
# WEB_FETCH_MAX_OUTPUT_CHARS=200000

# 调试：设为 true 时，服务端终端会打印发给 DeepSeek 的完整 messages + tools
# DEBUG_DEEPSEEK=true
